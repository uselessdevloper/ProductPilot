{
  "name": "productpilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProductPilot AI — Autonomous Industrial Product Intelligence for B2B Commerce.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/sync-datasets.mjs && node ../../backend/productpilotai/server.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "electron": "node scripts/build.mjs && electron .",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "test": "node scripts/sync-datasets.mjs"
  },
  "dependencies": {
    "jspdf": "^2.5.1",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ai.productpilot.desktop",
    "productName": "ProductPilot AI",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    }
  }
}
